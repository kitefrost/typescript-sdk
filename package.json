{
  "name": "@kitefrost/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the KiteFrost API",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest && npm test --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kitefrost",
    "ai",
    "sdk",
    "narrative",
    "npc",
    "game"
  ],
  "homepage": "https://kitefrost.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitefrost/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/kitefrost/typescript-sdk/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
