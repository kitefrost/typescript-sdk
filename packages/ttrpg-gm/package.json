{
  "name": "@kitefrost/ttrpg-gm",
  "version": "1.2.0-alpha.2",
  "description": "Per-pack KiteFrost SDK for the ttrpg-gm pack (clean brand-host URLs; depends on @kitefrost/core). PPI-3.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && printf '{\"type\":\"module\"}' > dist/esm/package.json && printf '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kitefrost",
    "sdk",
    "ttrpg-gm"
  ],
  "homepage": "https://kitefrost.ai",
  "license": "MIT",
  "dependencies": {
    "@kitefrost/core": "^1.2.0-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
